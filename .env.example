# Copy to ignored .env; use a secret manager for approved deployment. Never paste secrets in chat.
NODE_ENV=development
DEV_PASSWORD_LOGIN=0
PORT=8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
GOOGLE_WORKSPACE_DOMAIN=chargemod.com
# Dedicated ERP identity; leave unset to fail closed. Not a staff session.
ERP_WEBHOOK_SECRET=
ERP_SOURCE=
ERP_ORG=
AWS_REGION=ap-south-1
# Planned production adapters; not consumed by current SQLite development runtime.
DATABASE_URL=
PRIVATE_DOCUMENT_BUCKET=

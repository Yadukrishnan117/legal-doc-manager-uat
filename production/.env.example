# Inject values through your deployment secret manager. Do not commit filled files.
NODE_ENV=production
PORT=8788
APP_ORIGIN=
DATABASE_URL=
DATABASE_CA_FILE=
# Migration owner is used ONLY by the operator migration command, never by the app.
MIGRATION_DATABASE_URL=
# Base64 of a cryptographically generated 32-byte encryption key. Preserve in backups.
LDM_DATA_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=chargemod.com
S3_BUCKET=
S3_KMS_KEY_ARN=
CLAMAV_HOST=
CLAMAV_PORT=3310
